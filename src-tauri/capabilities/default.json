{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults plus an explicit grant for each app command (app_info, the audio_* commands and the file commands), and opening http(s) links in the system browser. No dialog, fs or other opener permission is granted.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-audio-open",
    "allow-audio-close",
    "allow-audio-release-input",
    "allow-audio-set-input",
    "allow-audio-permission",
    "allow-audio-clock-sync",
    "allow-audio-clock-check",
    "allow-audio-put-buffer",
    "allow-audio-decode",
    "allow-audio-drop-buffers",
    "allow-audio-schedule",
    "allow-audio-stop-voices",
    "allow-audio-cancel",
    "allow-audio-capture-start",
    "allow-audio-capture-stop",
    "allow-audio-measure-loopback",
    "allow-audio-debug-hooks",
    "allow-audio-debug-signal",
    "allow-save-file",
    "allow-open-licence",
    "allow-keep-awake",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ]
}
