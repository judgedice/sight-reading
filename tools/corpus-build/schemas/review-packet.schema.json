{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sight-reading.local/tools/corpus-build/schemas/review-packet.schema.json",
  "title": "Review packet",
  "description": "One packet of the agent review queue (03 section 6.12 R2, R3), written by `python -m corpus_build review-export` to build/review/packet-NN.json. About 40 items: queue windows at L1 to L3 (ruling 48) and blind controls, in a shuffled order, with opaque item ids. Title and composer are withheld. The mapping from item ids to windows and controls is in build/review-key/, which the reviewer must not read.",
  "type": "object",
  "required": ["packetId", "packetHash", "promptVersion", "variants", "instructions", "itemCount", "items"],
  "additionalProperties": false,
  "properties": {
    "packetId": {"type": "string", "pattern": "^packet-[0-9]{2}$"},
    "packetHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "sha256 over the canonical JSON of the items."},
    "promptVersion": {"type": "string"},
    "variants": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Verdict file letter -> promptVariant."},
    "instructions": {"type": "string"},
    "itemCount": {"type": "integer", "minimum": 1},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["itemId", "key", "meter", "bars", "pickup", "tempo", "taggedLevel", "featureLevels", "source", "range", "notes"],
      "additionalProperties": false,
      "properties": {
        "itemId": {"type": "string", "pattern": "^item-[0-9]{2}$"},
        "key": {"type": "string", "description": "Written key and signature, for example 'Bb major (2 flats)'."},
        "meter": {"type": "string"},
        "bars": {"type": "integer", "minimum": 1, "description": "Full bars, pickup not counted."},
        "pickup": {"type": ["string", "null"], "description": "Pickup length in beats, or null."},
        "tempo": {
          "type": "object",
          "required": ["marking", "markingBpm", "servedBpm"],
          "additionalProperties": false,
          "properties": {
            "marking": {"type": ["string", "null"]},
            "markingBpm": {"type": ["number", "null"]},
            "servedBpm": {"type": "object", "required": ["minBpm", "maxBpm"], "properties": {"minBpm": {"type": "number"}, "maxBpm": {"type": "number"}}}
          }
        },
        "taggedLevel": {"type": "integer", "minimum": 1, "maximum": 10},
        "featureLevels": {"type": "object", "additionalProperties": {"type": "integer"}},
        "source": {
          "type": "object",
          "required": ["collection", "part", "measures", "noteValuesDoubled"],
          "additionalProperties": false,
          "properties": {
            "collection": {"type": "string"},
            "part": {"type": "string"},
            "measures": {"type": ["string", "null"], "description": "First and last printed source measure numbers."},
            "noteValuesDoubled": {"type": "boolean", "description": "Rhythm augmented x2 from the source (03 6.8)."}
          }
        },
        "range": {"type": "string"},
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bar", "notes"],
            "additionalProperties": false,
            "properties": {"bar": {"type": ["integer", "string"]}, "notes": {"type": "string"}}
          }
        }
      }
    }
  }
}
