{
  "$id": "follow-fixture.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FollowFixture",
  "definitions": {
    "Alter": {
      "type": "number",
      "enum": [
        -2,
        -1,
        0,
        1,
        2
      ],
      "description": "Chromatic alteration in semitones. Triple accidentals do not exist (03 §7.5)."
    },
    "Beats": {
      "type": "number",
      "description": "Float, in metronome beats (02 conventions: quarter in x/4, half in 2/2, dotted quarter in 6/8) (01 §5.1)."
    },
    "ClockSeconds": {
      "type": "number",
      "description": "Seconds on the audio backend's clock (the AudioContext clock on web). Opaque and branded so that score time and clock time cannot be mixed by accident. Serialised as a plain number (01 §5.2, §7.1)."
    },
    "DetectedNote": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Unique per take, increasing."
        },
        "onset": {
          "$ref": "#/definitions/ClockSeconds",
          "description": "Per core/onset-definition.ts."
        },
        "offset": {
          "anyOf": [
            {
              "$ref": "#/definitions/ClockSeconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "provisionalMidi": {
          "type": "number",
          "description": "Median of the confirming frames, fractional concert MIDI."
        },
        "midi": {
          "type": "number",
          "description": "Fractional concert MIDI, median of the steady part so far."
        },
        "stableMedianCents": {
          "type": "number",
          "description": "Steady median as cents relative to the nearest semitone of `midi`, cents."
        },
        "steadyMs": {
          "type": "number",
          "description": "Steady duration (01 §7.5), ms."
        },
        "pitchSdCents": {
          "type": "number",
          "description": "Pitch SD over the steady part, cents."
        },
        "clarity": {
          "type": "number",
          "description": "Median clarity, 0..1."
        },
        "altOctaveClarity": {
          "type": [
            "number",
            "null"
          ],
          "description": "NSDF value at the expected octave's lag, for score-informed octave correction (01 §7.3)."
        },
        "onsetCause": {
          "type": "string",
          "enum": [
            "pitch-change",
            "repeat",
            "flux",
            "from-silence"
          ]
        },
        "framesAgree": {
          "type": "boolean",
          "description": "The confirming frames sit on one semitone (01 §9.3 item 3: a wrong pitch at confirmation needs them to agree). False when they straddle a semitone (an attack scoop) or when the note started with no frames of its own."
        }
      },
      "required": [
        "id",
        "onset",
        "offset",
        "provisionalMidi",
        "midi",
        "stableMedianCents",
        "steadyMs",
        "pitchSdCents",
        "clarity",
        "altOctaveClarity",
        "onsetCause",
        "framesAgree"
      ],
      "additionalProperties": false,
      "description": "A detected note (01 §5.6)."
    },
    "DspEvent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "note-on"
            },
            "note": {
              "$ref": "#/definitions/DetectedNote"
            }
          },
          "required": [
            "type",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "note-update"
            },
            "note": {
              "$ref": "#/definitions/DetectedNote"
            }
          },
          "required": [
            "type",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "note-off"
            },
            "note": {
              "$ref": "#/definitions/DetectedNote"
            }
          },
          "required": [
            "type",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "signal"
            },
            "levelDb": {
              "type": "number"
            },
            "clipping": {
              "type": "boolean"
            },
            "voiced": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "levelDb",
            "clipping",
            "voiced"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gap"
            },
            "missingBlocks": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "missingBlocks"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EndReason": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "complete"
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "stopped"
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "void"
            },
            "voidReason": {
              "$ref": "#/definitions/VoidReason"
            }
          },
          "required": [
            "reason",
            "voidReason"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Why a take ended (01 §5.7, §9.4)."
    },
    "ExpectedNote": {
      "type": "object",
      "properties": {
        "idx": {
          "type": "number",
          "description": "0-based index in the take."
        },
        "eventIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Event ids in the tie chain."
        },
        "bar": {
          "type": "number",
          "description": "Displayed bar number (pickup = 0)."
        },
        "beatInBar": {
          "$ref": "#/definitions/Beats",
          "description": "1-based beat position in the bar, metronome beats (1 = downbeat; may be fractional)."
        },
        "onsetBeat": {
          "$ref": "#/definitions/Beats",
          "description": "Onset from bar 1 beat 1, beats (negative in the pickup)."
        },
        "durBeats": {
          "$ref": "#/definitions/Beats"
        },
        "onsetSec": {
          "$ref": "#/definitions/ScoreSeconds",
          "description": "Onset, score seconds at the take's bpm."
        },
        "durSec": {
          "type": "number",
          "description": "Written duration, seconds."
        },
        "concertMidi": {
          "type": "number",
          "description": "Concert MIDI (integer)."
        },
        "writtenPitch": {
          "$ref": "#/definitions/SpelledPitch"
        },
        "ioiPrevSec": {
          "type": [
            "number",
            "null"
          ],
          "description": "IOI to the previous / next score note, seconds; null at the ends."
        },
        "ioiNextSec": {
          "type": [
            "number",
            "null"
          ]
        },
        "precededByRest": {
          "type": "boolean"
        },
        "followedByRest": {
          "type": "boolean"
        },
        "onsetKind": {
          "$ref": "#/definitions/OnsetKind",
          "description": "From slur, tie and repeat flags; drives floors and segmenter hints."
        },
        "artic": {
          "type": "string",
          "enum": [
            "normal",
            "staccato",
            "tenuto",
            "accent"
          ]
        },
        "durationGraded": {
          "type": "boolean",
          "description": "02 §4.3 duration rule, computed once."
        },
        "keySigAltered": {
          "type": "boolean",
          "description": "Pattern inputs (02 §6.2)."
        },
        "explicitAccidental": {
          "type": "boolean"
        },
        "ledgerLines": {
          "type": "number"
        }
      },
      "required": [
        "idx",
        "eventIds",
        "bar",
        "beatInBar",
        "onsetBeat",
        "durBeats",
        "onsetSec",
        "durSec",
        "concertMidi",
        "writtenPitch",
        "ioiPrevSec",
        "ioiNextSec",
        "precededByRest",
        "followedByRest",
        "onsetKind",
        "artic",
        "durationGraded",
        "keySigAltered",
        "explicitAccidental",
        "ledgerLines"
      ],
      "additionalProperties": false,
      "description": "One graded score note; a tie chain is one note (01 §6.4)."
    },
    "FollowFixture": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "excerptId": {
          "type": "string",
          "description": "Fixture-corpus excerpt the expected notes came from."
        },
        "instrumentId": {
          "type": "string"
        },
        "level": {
          "type": "number"
        },
        "bpm": {
          "type": "number"
        },
        "writtenKey": {
          "$ref": "#/definitions/KeySig"
        },
        "expected": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExpectedNote"
          },
          "description": "Golden expected notes (copied from fixtures/expected/ or built by the same function)."
        },
        "t0": {
          "$ref": "#/definitions/ClockSeconds"
        },
        "latencyCompensationSec": {
          "type": "number"
        },
        "voiceReferenceCents": {
          "type": "number"
        },
        "stream": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FollowStreamItem"
          }
        },
        "expectLive": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Predicate"
          },
          "description": "Predicates over the live event list (subject: `{ events: FollowerEvent[]; judgments: LiveJudgment[] }`)."
        },
        "expectFinal": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Predicate"
          },
          "description": "Predicates over `FinalAlignment`."
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "description",
        "excerptId",
        "instrumentId",
        "level",
        "bpm",
        "writtenKey",
        "expected",
        "t0",
        "latencyCompensationSec",
        "voiceReferenceCents",
        "stream",
        "expectLive",
        "expectFinal"
      ],
      "additionalProperties": false,
      "description": "`fixtures/follow/*.json` (01 §14 item 9)."
    },
    "FollowStreamItem": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "dsp"
            },
            "t": {
              "$ref": "#/definitions/ClockSeconds"
            },
            "event": {
              "$ref": "#/definitions/DspEvent"
            }
          },
          "required": [
            "kind",
            "t",
            "event"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "clock"
            },
            "t": {
              "$ref": "#/definitions/ClockSeconds"
            }
          },
          "required": [
            "kind",
            "t"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "end"
            },
            "t": {
              "$ref": "#/definitions/ClockSeconds"
            },
            "end": {
              "$ref": "#/definitions/EndReason"
            }
          },
          "required": [
            "kind",
            "t",
            "end"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Item of a follow fixture input stream, in clock seconds (01 §14 item 9)."
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          }
        }
      ],
      "description": "JSON value (for kv documents and predicates)."
    },
    "KeySig": {
      "type": "object",
      "properties": {
        "fifths": {
          "type": "number",
          "description": "Sharps positive, flats negative, −7..7."
        },
        "mode": {
          "type": "string",
          "enum": [
            "major",
            "minor"
          ]
        }
      },
      "required": [
        "fifths",
        "mode"
      ],
      "additionalProperties": false,
      "description": "A key signature (01 §5.3)."
    },
    "OnsetKind": {
      "type": "string",
      "enum": [
        "articulated",
        "slurred",
        "repeat"
      ]
    },
    "Predicate": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Dotted path into the subject, with `[n]` indices, `[*]` (every element must satisfy) and `[?]` (at least one element satisfies), for example \"judgments[*].timing\" or \"score.components.R\". For `fires` / `not-fires` the path is a pattern id."
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "approx",
            "in",
            "includes",
            "excludes",
            "length",
            "exists",
            "absent",
            "fires",
            "not-fires",
            "only-fires"
          ]
        },
        "value": {
          "$ref": "#/definitions/JsonValue",
          "description": "Comparison value. `approx`: number, with `tolerance`. `in`: array of allowed values. `includes` / `excludes`: an element the array at `path` must or must not contain. `length`: the array length. `exists` / `absent`: no value. `fires` / `not-fires`: no value. `only-fires`: array of pattern ids."
        },
        "tolerance": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "description": "Why the predicate holds (cites the spec)."
        }
      },
      "required": [
        "path",
        "op"
      ],
      "additionalProperties": false,
      "description": "Assertion predicate used by follow and grade fixtures instead of hand-computed totals (01 §14 items 9, 10)."
    },
    "ScoreSeconds": {
      "type": "number",
      "description": "Seconds from bar 1 beat 1; negative in the pickup and the count-in (01 §5.1)."
    },
    "SpelledPitch": {
      "type": "object",
      "properties": {
        "step": {
          "$ref": "#/definitions/Step"
        },
        "alter": {
          "$ref": "#/definitions/Alter"
        },
        "octave": {
          "type": "number",
          "description": "Scientific octave number (C4 = middle C)."
        }
      },
      "required": [
        "step",
        "alter",
        "octave"
      ],
      "additionalProperties": false,
      "description": "A spelled pitch. C4 = MIDI 60 (01 §5.3)."
    },
    "Step": {
      "type": "string",
      "enum": [
        "C",
        "D",
        "E",
        "F",
        "G",
        "A",
        "B"
      ]
    },
    "VoidReason": {
      "type": "string",
      "enum": [
        "interrupted",
        "no-signal",
        "device-change",
        "backlog",
        "capture-gap",
        "stopped-before-first-note"
      ],
      "description": "Why a take was voided (01 §7.9, 05 W4, 02 §5.3). Clipping is a results banner, not a void (01 §7.9). `stopped-before-first-note`: a second Stop before the first note in a ranked take (02 §5.3)."
    }
  }
}
