{
  "$id": "levels.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/LevelsConfig",
  "definitions": {
    "LevelDef": {
      "type": "object",
      "properties": {
        "_source": {
          "type": "string"
        },
        "level": {
          "type": "number"
        },
        "meters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Meters allowed at this level, as \"beats/beatType\" strings, cumulative."
        },
        "rhythmCells": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Rhythm cell ids allowed at this level, cumulative (02 §2.2)."
        },
        "maxIntervalSemis": {
          "type": [
            "number",
            "null"
          ],
          "description": "Largest free interval, semitones; null = any in range."
        },
        "largerLeaps": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "triad": {
                  "type": "string",
                  "enum": [
                    "tonic",
                    "tonic-or-dominant"
                  ]
                },
                "maxSemis": {
                  "type": "number"
                }
              },
              "required": [
                "triad",
                "maxSemis"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Larger leaps allowed on chord tones (L1–L3), or null."
        },
        "maxLeapsPer4Bars": {
          "type": [
            "number",
            "null"
          ],
          "description": "Leaps (a 4th or larger) per 4 bars; null = no limit."
        },
        "maxSpanSemis": {
          "type": [
            "number",
            "null"
          ],
          "description": "Span limit, semitones; null = the tier band."
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "major",
              "minor"
            ]
          },
          "description": "Tonal modes allowed (major, minor kinds)."
        },
        "minorForms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "natural",
              "harmonic",
              "melodic"
            ]
          },
          "description": "Minor forms allowed (natural, harmonic, melodic)."
        },
        "modal": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Mode"
          },
          "description": "Church modes allowed, served only when the key is random (R8)."
        },
        "chromaticPer4Bars": {
          "type": [
            "number",
            "null"
          ],
          "description": "Chromatic notes per 4 bars; null = no limit."
        },
        "minorAlterationsDiatonic": {
          "type": "boolean",
          "description": "Raised 6th and 7th in minor count as diatonic at this level (02 §2.3: from L5)."
        },
        "doubleAccidentals": {
          "type": "boolean"
        },
        "writtenKeys": {
          "type": "object",
          "properties": {
            "maxAccidentals": {
              "type": "number"
            },
            "modes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "major",
                  "minor"
                ]
              }
            }
          },
          "required": [
            "maxAccidentals",
            "modes"
          ],
          "additionalProperties": false,
          "description": "Written-key request constraint: maximum accidentals and allowed key modes (R1)."
        },
        "tier": {
          "$ref": "#/definitions/TierId"
        },
        "tempo": {
          "type": "object",
          "properties": {
            "minBpm": {
              "type": "number"
            },
            "maxBpm": {
              "type": "number"
            }
          },
          "required": [
            "minBpm",
            "maxBpm"
          ],
          "additionalProperties": false,
          "description": "Tempo range, bpm of the metronome beat."
        },
        "npsCap": {
          "type": "object",
          "properties": {
            "512": {
              "type": "number"
            },
            "1024": {
              "type": "number"
            },
            "2048": {
              "type": "number"
            }
          },
          "required": [
            "512",
            "1024",
            "2048"
          ],
          "additionalProperties": false,
          "description": "Peak notes per second in any one-beat window, per analysis window class (R18). Effective cap is `min(this, 1000 / pitchChangeFloorMs)` (02 §2.4, 01 §8.3)."
        },
        "articulations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Articulation and dynamic marks shown at this level, cumulative (02 §2.3)."
        },
        "bars": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Allowed bar counts (02 §2.3 \"Bars\")."
        },
        "scanSec": {
          "type": "number",
          "description": "Strict scan time, seconds; ranked uses exactly this (R6)."
        },
        "countInBars": {
          "type": "number",
          "description": "Count-in length, bars."
        },
        "description": {
          "type": "string",
          "description": "≤ 60 characters (02 §2.3)."
        }
      },
      "required": [
        "_source",
        "articulations",
        "bars",
        "chromaticPer4Bars",
        "countInBars",
        "description",
        "doubleAccidentals",
        "largerLeaps",
        "level",
        "maxIntervalSemis",
        "maxLeapsPer4Bars",
        "maxSpanSemis",
        "meters",
        "minorAlterationsDiatonic",
        "minorForms",
        "modal",
        "modes",
        "npsCap",
        "rhythmCells",
        "scanSec",
        "tempo",
        "tier",
        "writtenKeys"
      ],
      "additionalProperties": false,
      "description": "One level of `config/levels.json` (02 §2.3, §2.4)."
    },
    "LevelRange": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Inclusive level range, for example [1, 3] for L1–L3."
    },
    "LevelsConfig": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "configVersion": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LevelDef"
          }
        },
        "countIn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slowBelowBpm": {
              "type": "number"
            },
            "slowBars": {
              "type": "number"
            },
            "_source": {
              "type": "string"
            }
          },
          "required": [
            "_source",
            "slowBars",
            "slowBelowBpm"
          ],
          "description": "Count-in bars at any tempo below `slowBelowBpm` (02 §2.3; PLAN R70 makes it 1 everywhere)."
        },
        "compound": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dottedBeatLevels": {
              "$ref": "#/definitions/LevelRange"
            },
            "dottedBpm": {
              "type": "object",
              "properties": {
                "minBpm": {
                  "type": "number"
                },
                "maxBpm": {
                  "type": "number"
                }
              },
              "required": [
                "minBpm",
                "maxBpm"
              ],
              "additionalProperties": false
            },
            "subdivisionClicks": {
              "type": "boolean"
            },
            "_source": {
              "type": "string"
            }
          },
          "required": [
            "_source",
            "dottedBeatLevels",
            "dottedBpm",
            "subdivisionClicks"
          ],
          "description": "Compound meters at these levels count dotted beats in this bpm range with subdivision clicks (02 §2.4)."
        },
        "breath": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxGapBarsUpToLevel4": {
              "type": "number"
            },
            "maxGapSecFromLevel5": {
              "type": "number"
            },
            "_source": {
              "type": "string"
            }
          },
          "required": [
            "_source",
            "maxGapBarsUpToLevel4",
            "maxGapSecFromLevel5"
          ],
          "description": "Breath rule for winds, brass and voice (02 §2.4)."
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxFracFromLevelBelow": {
              "type": "number",
              "description": "At most this share of served excerpts from L − 1 (0.2)."
            },
            "stretchRate": {
              "type": "number",
              "description": "Stretch excerpts (one feature at L + 1) rate (0.2)."
            },
            "stretchRateLowPool": {
              "type": "number",
              "description": "Stretch rate when fewer than `lowPoolUnseen` unseen eligible excerpts remain (0.5 below 10)."
            },
            "lowPoolUnseen": {
              "type": "number"
            },
            "randomKey": {
              "type": "object",
              "properties": {
                "stringsSharpWeight": {
                  "type": "number",
                  "description": "Strings weight sharp written keys by this (1.5)."
                },
                "transposingLowAccWeight": {
                  "type": "number",
                  "description": "Concert B♭, E♭ and F instruments weight written keys with ≤ `lowAccMax` accidentals by this up to `lowAccMaxLevel`."
                },
                "lowAccMax": {
                  "type": "number"
                },
                "lowAccMaxLevel": {
                  "type": "number"
                },
                "maxSameKeyInRow": {
                  "type": "number",
                  "description": "Never the same written key more than this many times in a row (2)."
                }
              },
              "required": [
                "stringsSharpWeight",
                "transposingLowAccWeight",
                "lowAccMax",
                "lowAccMaxLevel",
                "maxSameKeyInRow"
              ],
              "additionalProperties": false
            },
            "_source": {
              "type": "string"
            }
          },
          "required": [
            "_source",
            "lowPoolUnseen",
            "maxFracFromLevelBelow",
            "randomKey",
            "stretchRate",
            "stretchRateLowPool"
          ],
          "description": "Selection policy (02 §2.6; R22)."
        }
      },
      "required": [
        "configVersion",
        "levels",
        "countIn",
        "compound",
        "breath",
        "selection"
      ],
      "additionalProperties": false,
      "description": "`config/levels.json` (02 §2, §10)."
    },
    "Mode": {
      "type": "string",
      "enum": [
        "major",
        "minor",
        "dorian",
        "mixolydian",
        "phrygian",
        "lydian",
        "aeolian",
        "locrian"
      ],
      "description": "Mode of an excerpt. Church modes appear only when the key is random (R8, 02 §2.3)."
    },
    "TierId": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ],
      "description": "Range tier: A = L1–2, B = L3–4, C = L5–6, D = L7–8, E = L9–10 (02 §1.4)."
    }
  }
}
