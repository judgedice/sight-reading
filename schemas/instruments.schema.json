{
  "$id": "instruments.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/InstrumentsConfig",
  "definitions": {
    "Clef": {
      "type": "string",
      "enum": [
        "treble",
        "bass",
        "alto",
        "tenor",
        "treble-8vb"
      ]
    },
    "DetectionParams": {
      "type": "object",
      "properties": {
        "minHz": {
          "type": "number",
          "description": "Lowest sounding fundamental to search, Hz (sounding range widened by 3 semitones)."
        },
        "maxHz": {
          "type": "number",
          "description": "Highest sounding fundamental to search, Hz."
        },
        "windowSamples": {
          "$ref": "#/definitions/WindowSamples"
        },
        "onsetProfile": {
          "$ref": "#/definitions/OnsetProfile"
        },
        "vibratoClass": {
          "$ref": "#/definitions/VibratoClass"
        },
        "clarityThreshold": {
          "type": "number",
          "description": "NSDF clarity threshold, 0..1 (0.85 default; 0.80 voice, low brass, piano)."
        },
        "changeCents": {
          "type": "number",
          "description": "Pitch change that splits a note, cents (voice 80, winds/brass/strings 60, fixed pitch 40)."
        }
      },
      "required": [
        "minHz",
        "maxHz",
        "windowSamples",
        "onsetProfile",
        "vibratoClass",
        "clarityThreshold",
        "changeCents"
      ],
      "additionalProperties": false,
      "description": "Detection parameters per instrument. 01 owns these values (01 §7.3)."
    },
    "Family": {
      "type": "string",
      "enum": [
        "voice",
        "flute",
        "double-reed",
        "clarinet",
        "sax",
        "high-brass",
        "low-brass",
        "upper-strings",
        "low-strings",
        "keyboard",
        "guitar"
      ],
      "description": "Instrument family; sets tips and family rules (02 §1.1)."
    },
    "Instrument": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id, for example `trumpet-bb`, `voice-tenor` (02 §1.1)."
        },
        "label": {
          "type": "string",
          "description": "English display label; 04 may override through copy."
        },
        "family": {
          "$ref": "#/definitions/Family"
        },
        "status": {
          "type": "string",
          "enum": [
            "launch",
            "beta"
          ],
          "description": "`beta` instruments are hidden behind a setting and get universal tips only (02 §1.2)."
        },
        "semis": {
          "type": "number",
          "description": "Written pitch minus concert pitch, semitones (ear-to-staff convention, 02 §1.3)."
        },
        "writtenMinusSounding": {
          "$ref": "#/definitions/Interval",
          "description": "Spelled form of `semis` (for example B♭ clarinet {diatonic: 1, chromatic: 2}) (03 §7.3)."
        },
        "clefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clef": {
                "$ref": "#/definitions/Clef"
              },
              "fromLevel": {
                "type": "number"
              }
            },
            "required": [
              "clef",
              "fromLevel"
            ],
            "additionalProperties": false
          },
          "description": "Clefs and the level from which each is allowed; the first entry is the primary clef (02 §1.3)."
        },
        "fullWrittenRange": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Outer written MIDI bounds ever served, inclusive (02 §1.3)."
        },
        "tiers": {
          "type": "object",
          "properties": {
            "A": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "B": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "C": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "D": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "E": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ],
          "additionalProperties": false,
          "description": "Written MIDI band per tier, inclusive (02 §1.4)."
        },
        "pitchKind": {
          "type": "string",
          "enum": [
            "continuous",
            "fixed"
          ],
          "description": "`fixed` = piano and guitar: no intonation, no duration credit (02 §4.5)."
        },
        "relativePitch": {
          "type": "boolean",
          "description": "Voice: graded on relative pitch, octave-equivalent (R7, 02 §4.5)."
        },
        "onsetClass": {
          "$ref": "#/definitions/OnsetClass",
          "description": "Timing-floor class (02 §1.1)."
        },
        "testkitTimbre": {
          "anyOf": [
            {
              "$ref": "#/definitions/TestkitTimbre"
            },
            {
              "type": "null"
            }
          ],
          "description": "Testkit timbre used by the synthetic gates, or null when none exists (02 §1.1, §1.2)."
        },
        "lowFundamental": {
          "type": "boolean",
          "description": "True when the lowest served fundamental is under 80 Hz: the intonation weight moves to pitch (02 §1.2, §4.4). A test asserts it agrees with the served range."
        },
        "detection": {
          "$ref": "#/definitions/DetectionParams",
          "description": "01 owns this block (01 §7.3)."
        }
      },
      "required": [
        "id",
        "label",
        "family",
        "status",
        "semis",
        "writtenMinusSounding",
        "clefs",
        "fullWrittenRange",
        "tiers",
        "pitchKind",
        "relativePitch",
        "onsetClass",
        "testkitTimbre",
        "lowFundamental",
        "detection"
      ],
      "additionalProperties": false,
      "description": "One entry of `config/instruments.json` (01 §5.4, 02 §1)."
    },
    "InstrumentsConfig": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "configVersion": {
          "type": "string"
        },
        "_source": {
          "type": "string"
        },
        "instruments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Instrument"
          }
        }
      },
      "required": [
        "configVersion",
        "_source",
        "instruments"
      ],
      "additionalProperties": false,
      "description": "`config/instruments.json`."
    },
    "Interval": {
      "type": "object",
      "properties": {
        "diatonic": {
          "type": "number",
          "description": "Letter steps, signed (a rising third is +2; an octave is +7)."
        },
        "chromatic": {
          "type": "number",
          "description": "Semitones, signed."
        }
      },
      "required": [
        "diatonic",
        "chromatic"
      ],
      "additionalProperties": false,
      "description": "A spelled interval (01 §5.3, 03 §7.4)."
    },
    "OnsetClass": {
      "type": "string",
      "enum": [
        "hard",
        "soft"
      ],
      "description": "Onset class; sets the timing floors (02 §1.1, §4.2)."
    },
    "OnsetProfile": {
      "type": "string",
      "enum": [
        "tongued-wind",
        "brass",
        "bowed",
        "plucked",
        "voice",
        "struck"
      ],
      "description": "Segmenter onset profile (01 §7.5)."
    },
    "TestkitTimbre": {
      "type": "string",
      "enum": [
        "flute",
        "clarinet",
        "sax",
        "trumpet",
        "violin",
        "cello",
        "voice",
        "piano",
        "tuba"
      ],
      "description": "Synthetic timbres the testkit renders (02 §1.1, R21)."
    },
    "VibratoClass": {
      "type": "string",
      "enum": [
        "none",
        "vibrato"
      ],
      "description": "Vibrato class; sets cents floors and `intonationMinSteadyMs` (01 §8.4)."
    },
    "WindowSamples": {
      "type": "number",
      "enum": [
        512,
        1024,
        2048
      ],
      "description": "MPM analysis window in samples at about 16 kHz (01 §7.3)."
    }
  }
}
