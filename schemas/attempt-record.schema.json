{
  "$id": "attempt-record.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AttemptRecord",
  "definitions": {
    "Alter": {
      "type": "number",
      "enum": [
        -2,
        -1,
        0,
        1,
        2
      ],
      "description": "Chromatic alteration in semitones. Triple accidentals do not exist (03 §7.5)."
    },
    "AppliedProcessing": {
      "type": "object",
      "properties": {
        "echoCancellation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "noiseSuppression": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "autoGainControl": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "echoCancellation",
        "noiseSuppression",
        "autoGainControl"
      ],
      "additionalProperties": false,
      "description": "Input processing flags as read back from `track.getSettings()`; null when not reported (05 W5)."
    },
    "AttemptKind": {
      "type": "string",
      "enum": [
        "excerpt",
        "scale"
      ],
      "description": "What an attempt practised: a corpus excerpt (the default) or a generated scale."
    },
    "AttemptRecheck": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "measured",
            "unmeasured"
          ],
          "description": "`measured`: ≥ min clicks with acceptable MAD. `unmeasured`: on speakers but could not measure (fails gate `recheck`)."
        },
        "measuredMs": {
          "type": [
            "number",
            "null"
          ],
          "description": "Measured RTL, ms; null when unmeasured."
        },
        "clicks": {
          "type": "number"
        },
        "madMs": {
          "type": [
            "number",
            "null"
          ],
          "description": "ms; null when unmeasured."
        },
        "usedFresh": {
          "type": "boolean",
          "description": "The take used the fresh value (differs from stored by more than the threshold)."
        },
        "promptRecalibrate": {
          "type": "boolean",
          "description": "Calibration marked stale; results prompt recalibration (R31)."
        }
      },
      "required": [
        "status",
        "measuredMs",
        "clicks",
        "madMs",
        "usedFresh",
        "promptRecalibrate"
      ],
      "additionalProperties": false,
      "description": "Recheck result on the attempt (01 §7.7; R31)."
    },
    "AttemptRecord": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "description": "UUID."
        },
        "profileId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 UTC."
        },
        "appVersion": {
          "type": "string"
        },
        "configVersion": {
          "type": "string"
        },
        "corpusVersion": {
          "type": "string"
        },
        "coreVersion": {
          "type": "string"
        },
        "excerptId": {
          "type": "string"
        },
        "dedupeGroup": {
          "type": "string"
        },
        "instrumentId": {
          "type": "string"
        },
        "beta": {
          "type": "boolean"
        },
        "levelServed": {
          "type": "number"
        },
        "stretch": {
          "type": "boolean"
        },
        "placement": {
          "type": "boolean",
          "description": "Placement attempt (02 §5.1): earns XP, not in the level window."
        },
        "settingsResolved": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seed": {
              "type": "number"
            },
            "instrumentId": {
              "type": "string"
            },
            "level": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "const": "random"
                }
              ]
            },
            "writtenKey": {
              "anyOf": [
                {
                  "$ref": "#/definitions/KeySig"
                },
                {
                  "type": "string",
                  "const": "random"
                }
              ],
              "description": "R1: the key the player reads."
            },
            "meter": {
              "type": "string",
              "description": "\"beats/beatType\", for example \"6/8\"."
            },
            "bpm": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "const": "random"
                }
              ],
              "description": "Metronome beats per minute."
            },
            "bars": {
              "type": [
                "number",
                "string"
              ],
              "enum": [
                8,
                10,
                12,
                "random"
              ],
              "description": "A preference, not a filter (04 §5.2)."
            },
            "mode": {
              "type": "string",
              "enum": [
                "ranked",
                "practice"
              ]
            },
            "listening": {
              "type": "boolean",
              "description": "false = practise without listening (R13)."
            },
            "metronome": {
              "$ref": "#/definitions/MetronomeMode"
            },
            "clickTimbre": {
              "$ref": "#/definitions/ClickTimbre"
            },
            "accentFirstBeat": {
              "type": "boolean",
              "description": "Accent the first beat of each bar. Absent means true; `defaultAppSettings` writes true. Optional until every PracticeSettings literal sets it."
            },
            "outputMode": {
              "$ref": "#/definitions/OutputMode"
            },
            "a4Hz": {
              "type": "number",
              "description": "Concert A4 reference, Hz, 415..446."
            },
            "autoReference": {
              "type": "boolean",
              "description": "Play the starting-note reference automatically before a try (default true)."
            }
          },
          "required": [
            "a4Hz",
            "bars",
            "bpm",
            "clickTimbre",
            "instrumentId",
            "level",
            "listening",
            "meter",
            "metronome",
            "mode",
            "outputMode",
            "seed",
            "writtenKey"
          ],
          "description": "The settings as requested, with the seed resolved."
        },
        "transposition": {
          "$ref": "#/definitions/Interval"
        },
        "writtenKey": {
          "$ref": "#/definitions/KeySig"
        },
        "concertKey": {
          "$ref": "#/definitions/KeySig"
        },
        "clef": {
          "$ref": "#/definitions/Clef"
        },
        "bpm": {
          "type": "number"
        },
        "scanSeconds": {
          "type": "number",
          "description": "Scan time actually used, seconds."
        },
        "listening": {
          "type": "boolean"
        },
        "calibration": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "loopback",
                "play-along",
                "reported",
                "none"
              ]
            },
            "latencyCompensationMs": {
              "type": "number"
            },
            "outputMode": {
              "$ref": "#/definitions/OutputMode"
            },
            "recheck": {
              "anyOf": [
                {
                  "$ref": "#/definitions/AttemptRecheck"
                },
                {
                  "type": "null"
                }
              ],
              "description": "null in headphone modes or when not listening."
            }
          },
          "required": [
            "method",
            "latencyCompensationMs",
            "outputMode",
            "recheck"
          ],
          "additionalProperties": false
        },
        "tuning": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "used": {
                  "type": "boolean"
                },
                "offsetCents": {
                  "type": "number"
                }
              },
              "required": [
                "used",
                "offsetCents"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Tuning note used and its offset, cents; null for voice and fixed pitch."
        },
        "audioEnv": {
          "$ref": "#/definitions/AudioEnv",
          "description": "05 §5.2, with gateFailures[]."
        },
        "detected": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DetectedNote"
          }
        },
        "judgments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NoteJudgment"
          }
        },
        "extras": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExtraNote"
          }
        },
        "displaced": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DisplacedSegment"
          }
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/definitions/AttemptScore"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when void or not listening."
        },
        "endReason": {
          "type": "string",
          "enum": [
            "complete",
            "stopped",
            "void"
          ]
        },
        "voidReason": {
          "$ref": "#/definitions/VoidReason"
        },
        "excerptBurned": {
          "type": "boolean",
          "description": "The excerpt is burned for ranked play (seen at reveal; a void after the first note still burns, 02 §4.7)."
        },
        "countsAsSkip": {
          "type": "boolean",
          "description": "Counts against the post-reveal skip limit (skip after reveal; interruption void after the first note, R33)."
        },
        "credit": {
          "$ref": "#/definitions/ExcerptCreditSnapshot"
        },
        "kind": {
          "$ref": "#/definitions/AttemptKind",
          "description": "What was practised. Absent on every attempt stored before scales existed, and it means `excerpt` (PLAN ruling 68)."
        },
        "scale": {
          "$ref": "#/definitions/ScaleRef",
          "description": "The scale, when `kind` is `scale`."
        },
        "debug": {
          "type": "object",
          "properties": {
            "live": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/LiveJudgment"
              }
            },
            "frames": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PitchFrame"
              }
            }
          },
          "required": [
            "live"
          ],
          "additionalProperties": false,
          "description": "Dev flag only; pruned after 7 days; never audio."
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "profileId",
        "createdAt",
        "appVersion",
        "configVersion",
        "corpusVersion",
        "coreVersion",
        "excerptId",
        "dedupeGroup",
        "instrumentId",
        "beta",
        "levelServed",
        "stretch",
        "placement",
        "settingsResolved",
        "transposition",
        "writtenKey",
        "concertKey",
        "clef",
        "bpm",
        "scanSeconds",
        "listening",
        "calibration",
        "tuning",
        "audioEnv",
        "detected",
        "judgments",
        "extras",
        "displaced",
        "score",
        "endReason",
        "excerptBurned",
        "countsAsSkip",
        "credit"
      ],
      "additionalProperties": false,
      "description": "One attempt; about 5 KB; never audio (01 §6.5, R9)."
    },
    "AttemptScore": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "incomplete"
          ]
        },
        "components": {
          "type": "object",
          "properties": {
            "P": {
              "type": "number"
            },
            "I": {
              "type": [
                "number",
                "null"
              ]
            },
            "R": {
              "type": "number"
            }
          },
          "required": [
            "P",
            "I",
            "R"
          ],
          "additionalProperties": false,
          "description": "0..100 each; I null = \"not enough notes to judge\" (weight moved to P)."
        },
        "weights": {
          "type": "object",
          "properties": {
            "P": {
              "type": "number"
            },
            "I": {
              "type": "number"
            },
            "R": {
              "type": "number"
            }
          },
          "required": [
            "P",
            "I",
            "R"
          ],
          "additionalProperties": false,
          "description": "Weights actually used (after moving I's weight where applicable)."
        },
        "score": {
          "type": "number",
          "description": "0..100, rounded; capped at 50 when incomplete."
        },
        "grade": {
          "$ref": "#/definitions/LetterGrade"
        },
        "stars": {
          "type": "number",
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "shine": {
          "type": "boolean"
        },
        "ranked": {
          "type": "boolean"
        },
        "rankedReasons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RankedReason"
          }
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "matched": {
              "type": "number",
              "description": "Matched notes excluding displaced, and N."
            },
            "n": {
              "type": "number"
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/StopDiagnostic"
              }
            },
            "restarts": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RestartDiagnostic"
              }
            },
            "driftMsAtEnd": {
              "type": [
                "number",
                "null"
              ],
              "description": "Least-squares drift at the end, ms; + = behind; null when too few notes."
            },
            "counts": {
              "$ref": "#/definitions/VerdictCounts"
            },
            "signal": {
              "type": "object",
              "properties": {
                "medianClarity": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "clippingFrac": {
                  "type": "number"
                }
              },
              "required": [
                "medianClarity",
                "clippingFrac"
              ],
              "additionalProperties": false,
              "description": "Signal quality for the clipping banner and tip gating (02 §6.1)."
            },
            "voiceDriftCents": {
              "type": [
                "number",
                "null"
              ],
              "description": "Final voice reference offset, cents (voice only)."
            }
          },
          "required": [
            "matched",
            "n",
            "stops",
            "restarts",
            "driftMsAtEnd",
            "counts",
            "signal",
            "voiceDriftCents"
          ],
          "additionalProperties": false
        },
        "patterns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PatternResult"
          }
        },
        "tipsShown": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Filled by the session after `selectTips`; `grade()` returns []."
        },
        "xp": {
          "$ref": "#/definitions/XpBreakdown"
        },
        "configVersion": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "components",
        "weights",
        "score",
        "grade",
        "stars",
        "shine",
        "ranked",
        "rankedReasons",
        "diagnostics",
        "patterns",
        "tipsShown",
        "xp",
        "configVersion"
      ],
      "additionalProperties": false,
      "description": "The score part of an attempt (02 §4, §9; R15: three components plus diagnostics)."
    },
    "AudioEnv": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/PlatformKind",
          "description": "'ios', 'desktop' and 'android' are the native shell (PLAN R85); the web build reports 'web'."
        },
        "osFamily": {
          "$ref": "#/definitions/OsFamily"
        },
        "displayMode": {
          "$ref": "#/definitions/DisplayMode"
        },
        "appBuild": {
          "type": "string"
        },
        "coreVersion": {
          "type": "string",
          "description": "Version of the shared pure core."
        },
        "inputPath": {
          "type": "string",
          "const": "mic",
          "description": "'midi' later."
        },
        "metronomeMode": {
          "$ref": "#/definitions/MetronomeMode"
        },
        "clickTimbre": {
          "$ref": "#/definitions/ClickTimbre"
        },
        "outputMode": {
          "$ref": "#/definitions/OutputMode"
        },
        "route": {
          "type": "object",
          "properties": {
            "inputKind": {
              "type": "string",
              "enum": [
                "built-in",
                "wired",
                "bluetooth",
                "usb-interface",
                "unknown"
              ]
            },
            "sampleRate": {
              "type": "number",
              "description": "Context sample rate, Hz."
            },
            "appliedProcessing": {
              "$ref": "#/definitions/AppliedProcessing"
            }
          },
          "required": [
            "inputKind",
            "sampleRate",
            "appliedProcessing"
          ],
          "additionalProperties": false
        },
        "contextSampleRate": {
          "type": "number",
          "description": "Hz."
        },
        "contextRecreated": {
          "type": "boolean"
        },
        "clockRateError": {
          "type": [
            "number",
            "null"
          ],
          "description": "Fractional clock-rate error (0.088 = 8.8% fast), null when not measured."
        },
        "audioSessionType": {
          "type": [
            "string",
            "null"
          ],
          "description": "`navigator.audioSession.type` as set, or null."
        },
        "latencyCompensationMs": {
          "type": "number",
          "description": "What follow/ subtracted, ms."
        },
        "calibrationMethod": {
          "type": "string",
          "enum": [
            "loopback",
            "play-along",
            "reported",
            "none"
          ]
        },
        "captureRelay": {
          "type": "boolean",
          "description": "Main-thread relay used (01 §7.2)."
        },
        "droppedBlocks": {
          "type": "number"
        },
        "maxQueueMs": {
          "type": "number",
          "description": "Largest DSP queue during the take, ms of audio."
        },
        "dspHopP95Ms": {
          "type": [
            "number",
            "null"
          ],
          "description": "DSP worker per-hop time p95, ms (diagnostics only)."
        },
        "gateFailures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GateId"
          }
        }
      },
      "required": [
        "platform",
        "osFamily",
        "displayMode",
        "appBuild",
        "coreVersion",
        "inputPath",
        "metronomeMode",
        "clickTimbre",
        "outputMode",
        "route",
        "contextSampleRate",
        "contextRecreated",
        "clockRateError",
        "audioSessionType",
        "latencyCompensationMs",
        "calibrationMethod",
        "captureRelay",
        "droppedBlocks",
        "maxQueueMs",
        "dspHopP95Ms",
        "gateFailures"
      ],
      "additionalProperties": false,
      "description": "Audio environment of an attempt; platform-neutral, JSON only, never identifies the person or device (05 §5.2)."
    },
    "Beats": {
      "type": "number",
      "description": "Float, in metronome beats (02 conventions: quarter in x/4, half in 2/2, dotted quarter in 6/8) (01 §5.1)."
    },
    "Clef": {
      "type": "string",
      "enum": [
        "treble",
        "bass",
        "alto",
        "tenor",
        "treble-8vb"
      ]
    },
    "ClickTimbre": {
      "anyOf": [
        {
          "type": "string",
          "const": "tick"
        },
        {
          "type": "string",
          "const": "wood"
        },
        {
          "$ref": "#/definitions/MetronomeSound"
        }
      ],
      "description": "Metronome click sound: Tick 5.5–9 kHz noise burst (speaker default) or Wood 1.5–4 kHz (01 §7.6)."
    },
    "ClockSeconds": {
      "type": "number",
      "description": "Seconds on the audio backend's clock (the AudioContext clock on web). Opaque and branded so that score time and clock time cannot be mixed by accident. Serialised as a plain number (01 §5.2, §7.1)."
    },
    "CorpusId": {
      "type": "string",
      "enum": [
        "openscore-lieder",
        "openscore-quartets",
        "mutopia"
      ],
      "description": "v1 corpus sources, all fetched from GitHub (R4, R27)."
    },
    "DetectedNote": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Unique per take, increasing."
        },
        "onset": {
          "$ref": "#/definitions/ClockSeconds",
          "description": "Per core/onset-definition.ts."
        },
        "offset": {
          "anyOf": [
            {
              "$ref": "#/definitions/ClockSeconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "provisionalMidi": {
          "type": "number",
          "description": "Median of the confirming frames, fractional concert MIDI."
        },
        "midi": {
          "type": "number",
          "description": "Fractional concert MIDI, median of the steady part so far."
        },
        "stableMedianCents": {
          "type": "number",
          "description": "Steady median as cents relative to the nearest semitone of `midi`, cents."
        },
        "steadyMs": {
          "type": "number",
          "description": "Steady duration (01 §7.5), ms."
        },
        "pitchSdCents": {
          "type": "number",
          "description": "Pitch SD over the steady part, cents."
        },
        "clarity": {
          "type": "number",
          "description": "Median clarity, 0..1."
        },
        "altOctaveClarity": {
          "type": [
            "number",
            "null"
          ],
          "description": "NSDF value at the expected octave's lag, for score-informed octave correction (01 §7.3)."
        },
        "onsetCause": {
          "type": "string",
          "enum": [
            "pitch-change",
            "repeat",
            "flux",
            "from-silence"
          ]
        },
        "framesAgree": {
          "type": "boolean",
          "description": "The confirming frames sit on one semitone (01 §9.3 item 3: a wrong pitch at confirmation needs them to agree). False when they straddle a semitone (an attack scoop) or when the note started with no frames of its own."
        }
      },
      "required": [
        "id",
        "onset",
        "offset",
        "provisionalMidi",
        "midi",
        "stableMedianCents",
        "steadyMs",
        "pitchSdCents",
        "clarity",
        "altOctaveClarity",
        "onsetCause",
        "framesAgree"
      ],
      "additionalProperties": false,
      "description": "A detected note (01 §5.6)."
    },
    "DisplacedSegment": {
      "type": "object",
      "properties": {
        "fromIdx": {
          "type": "number",
          "description": "Expected-note index range the played notes matched, inclusive."
        },
        "toIdx": {
          "type": "number"
        },
        "offsetBeats": {
          "$ref": "#/definitions/Beats",
          "description": "Offset of the player from the metronome, beats (negative = went back)."
        },
        "detectedIds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "fromIdx",
        "toIdx",
        "offsetBeats",
        "detectedIds"
      ],
      "additionalProperties": false,
      "description": "A replayed or skipped-ahead run at a constant offset (01 §9.5, §9.6)."
    },
    "DisplayMode": {
      "type": "string",
      "enum": [
        "browser",
        "standalone"
      ],
      "description": "Whether the app runs in a browser tab or as an installed home-screen app (05 §5.1, W13)."
    },
    "ExcerptCreditSnapshot": {
      "type": "object",
      "properties": {
        "composer": {
          "type": "string"
        },
