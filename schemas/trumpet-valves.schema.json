{
  "$id": "trumpet-valves.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/TrumpetValveTable",
  "definitions": {
    "TrumpetValveTable": {
      "type": "object",
      "properties": {
        "_source": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "writtenMidi": {
                "type": "number",
                "description": "Written MIDI."
              },
              "valves": {
                "type": "string",
                "description": "Valve combination, for example \"0\", \"2\", \"1\", \"12\", \"23\", \"13\", \"123\"."
              },
              "partial": {
                "type": "number",
                "description": "Harmonic partial number, 2 = second partial."
              }
            },
            "required": [
              "writtenMidi",
              "valves",
              "partial"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "_source",
        "entries"
      ],
      "additionalProperties": false,
      "description": "`config/trumpet-valves.json`: written pitch to valve combination and partial, written F♯3 to C6 (02 §4.5, §10)."
    }
  }
}
