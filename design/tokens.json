    "$comment2": "Score tokens (the paper). Light paper is the default; dark theme always uses dark paper in v1. Emitted as --<name> under the same theme selectors, and also under :root[data-paper=\"light\"|\"dark\"].",
    "paper": {
      "paper": { "light": "#FFFDF8", "dark": "#1B1E23" },
      "ink": { "light": "#1A1A1A", "dark": "#ECE9E2" },
      "staff-line": { "light": "#7A7A7A", "dark": "#8C9098" },
      "correct": { "light": "#00756A", "dark": "#3FC7B4" },
      "error": { "light": "#C5300A", "dark": "#FF7B52" },
      "ghost": { "light": "#7A3EC8", "dark": "#BFA2FF" },
      "ghost-replay": { "light": "#6B6B6B", "dark": "#9AA0A8" },
      "active": { "light": "#1A1A1A", "dark": "#ECE9E2" },
      "playhead-bar": { "light": "rgba(47,75,216,0.08)", "dark": "rgba(143,161,255,0.10)" },
      "playhead-next": { "light": "rgba(47,75,216,0.60)", "dark": "rgba(143,161,255,0.60)" },
