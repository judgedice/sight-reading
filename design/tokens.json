    "body": { "size": 16, "line": 1.5, "weight": 400, "buttonWeight": 600 },
    "small": { "size": 14, "line": 1.45, "weight": 400 },
    "caption": { "size": 12, "line": 1.35, "weight": 500 }
  },

  "space": {
    "$comment": "4 px base. Emitted as --space-<n> in px.",
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64
  },

  "radius": {
    "$comment": "Emitted as --radius-<name> in px. Sheets use the xl value on their top corners only.",
    "s": 4,
    "m": 8,
    "l": 12,
    "xl": 20
  },

  "zIndex": {
    "base": 0,
    "sticky": 10,
    "sheet": 40,
    "popover": 45,
    "modal": 50,
    "toast": 60
  },

  "motion": {
    "$comment": "Durations in ms and easing curves. Emitted as --dur-<name> (ms) and --ease-<name>. Stylelint requires transitions to use motion tokens and the reduced-motion rule; see the Stylelint note in the wave 0 report.",
    "dur": {
      "instant": 0,
      "fast": 100,
      "base": 200,
      "slow": 320
    },
    "ease": {
      "out": "cubic-bezier(0.2, 0, 0, 1)",
      "in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },

  "breakpoints": {
    "$comment": "Viewport widths in CSS px (04 section 4.1). Not emitted as CSS variables (custom properties cannot drive media queries); read from tokens.ts. 'max' and 'min' are inclusive.",
    "xs": { "max": 567 },
    "sm": { "min": 568, "max": 767 },
    "md": { "min": 768, "max": 1023 },
    "lg": { "min": 1024, "max": 1439 },
    "xl": { "min": 1440 },
    "shortHeightBelow": 500
  },

  "pointer": {
