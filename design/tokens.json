      "metro-active": { "light": "#1A1A1A", "dark": "#ECE9E2" }
    },

    "$comment3": "High contrast overrides, applied under [data-contrast=\"high\"]. Only tokens the spec changes are listed.",
    "highContrast": {
      "ui": {},
      "paper": {
        "error": { "light": "#A32100", "dark": "#FF9A78" },
        "correct": { "light": "#005A52", "dark": "#6FE0D0" }
      }
    },

    "$comment4": "Forced colours (@media (forced-colors: active)). Emitted verbatim; glyphs carry the meaning in this mode.",
    "forced": {
      "ink": "CanvasText",
      "paper": "Canvas",
      "error": "Mark",
      "ghost": "LinkText",
      "correct": "CanvasText"
    },

    "$comment5": "Colour rule: disabled controls use 40% opacity on the whole control (WCAG exempts disabled controls from contrast).",
    "opacity": {
      "disabled": 0.4
    }
  },

  "contrast": {
    "$comment": "Pairs recomputed by src/ui/tokens.contrast.test.ts (WCAG relative luminance). 'min' is the stated minimum (text 4.5, graphics and boundaries 3). 'claimed' is the ratio stated in 04 section 7.1 for each theme; the test requires each recomputed ratio to be at least min and within 0.1 of the claim where one is given. Ratios are against the surface named in 'bg'.",
    "pairs": [
      { "id": "text-on-surface", "fg": "text", "bg": "surface", "min": 4.5, "claimed": { "light": 16.9, "dark": 14.2 } },
      { "id": "text-on-bg", "fg": "text", "bg": "bg", "min": 4.5 },
      { "id": "text-on-surface-2", "fg": "text", "bg": "surface-2", "min": 4.5 },
      { "id": "text-muted-on-surface", "fg": "text-muted", "bg": "surface", "min": 4.5, "claimed": { "light": 6.7, "dark": 7.2 } },
      { "id": "text-muted-on-surface-2", "fg": "text-muted", "bg": "surface-2", "min": 4.5 },
      { "id": "accent-on-surface", "fg": "accent", "bg": "surface", "min": 4.5, "claimed": { "light": 6.7, "dark": 7.0 } },
      { "id": "on-accent-on-accent", "fg": "on-accent", "bg": "accent", "min": 4.5 },
      { "id": "on-accent-on-accent-hover", "fg": "on-accent", "bg": "accent-hover", "min": 4.5 },
      { "id": "on-accent-on-accent-pressed", "fg": "on-accent", "bg": "accent-pressed", "min": 4.5 },
      { "id": "star-on-surface", "fg": "star", "bg": "surface", "min": 3, "claimed": { "light": 5.4, "dark": 8.6 } },
      { "id": "caution-on-surface", "fg": "caution", "bg": "surface", "min": 4.5 },
      { "id": "on-danger-on-danger", "fg": "on-danger", "bg": "danger", "min": 4.5, "claimed": { "light": 5.5, "dark": 7.2 } },
      { "id": "on-danger-on-danger-hover", "fg": "on-danger", "bg": "danger-hover", "min": 4.5 },
      { "id": "on-danger-on-danger-pressed", "fg": "on-danger", "bg": "danger-pressed", "min": 4.5 },
      { "id": "toast-text-on-toast-bg", "fg": "toast-text", "bg": "toast-bg", "min": 4.5 },
      { "id": "border-strong-on-surface", "fg": "border-strong", "bg": "surface", "min": 3 },
      { "id": "border-strong-on-bg", "fg": "border-strong", "bg": "bg", "min": 3 },
      { "id": "focus-ring-on-surface", "fg": "focus-ring", "bg": "surface", "min": 3 },
      { "id": "ink-on-paper", "fg": "ink", "bg": "paper", "min": 4.5, "claimed": { "light": 17.1, "dark": 13.8 }, "layer": "paper" },
      { "id": "staff-line-on-paper", "fg": "staff-line", "bg": "paper", "min": 3, "claimed": { "light": 4.2, "dark": 5.2 }, "layer": "paper" },
      { "id": "correct-on-paper", "fg": "correct", "bg": "paper", "min": 3, "claimed": { "light": 5.5, "dark": 8.0 }, "layer": "paper" },
      { "id": "error-on-paper", "fg": "error", "bg": "paper", "min": 3, "claimed": { "light": 5.4, "dark": 6.5 }, "layer": "paper" },
      { "id": "ghost-on-paper", "fg": "ghost", "bg": "paper", "min": 3, "claimed": { "light": 6.2, "dark": 7.8 }, "layer": "paper" },
      { "id": "ghost-replay-on-paper", "fg": "ghost-replay", "bg": "paper", "min": 3, "claimed": { "light": 5.2, "dark": 6.3 }, "layer": "paper" },
      { "id": "error-on-paper-high-contrast", "fg": "error", "bg": "paper", "min": 4.5, "layer": "paper-high-contrast" },
      { "id": "correct-on-paper-high-contrast", "fg": "correct", "bg": "paper", "min": 4.5, "layer": "paper-high-contrast" }
    ]
  },

  "font": {
    "$comment": "The spec names no token for the UI font stack; --font-ui is this build's name for it.",
    "ui": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "minSizePx": 12
  },

  "type": {
    "$comment": "Each scale entry is emitted as --type-<name>-size, -line and -weight. Sizes in px; line is a unitless line-height.",
    "grade": { "size": 72, "line": 1.0, "weight": 700 },
    "display": { "size": 48, "line": 1.1, "weight": 700 },
    "count": { "size": 32, "line": 1.0, "weight": 700 },
    "h1": { "size": 32, "line": 1.2, "weight": 650 },
    "h2": { "size": 24, "line": 1.25, "weight": 600 },
