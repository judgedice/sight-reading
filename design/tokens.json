      "surface-2-pressed": { "light": "#D1D0CA", "dark": "#3E4247" },
      "border": { "light": "#D6D3CA", "dark": "#323840" },
      "border-strong": { "light": "#8E8A80", "dark": "#6B727C" },
      "text": { "light": "#1B1D21", "dark": "#E9EBEE" },
      "text-muted": { "light": "#575C66", "dark": "#A3A9B3" },
      "accent": { "light": "#2F4BD8", "dark": "#8FA1FF" },
      "accent-hover": { "light": "#2D45C2", "dark": "#9AAAFD" },
      "accent-pressed": { "light": "#2B42B3", "dark": "#A1B0FC" },
      "on-accent": { "light": "#FFFFFF", "dark": "#121418" },
      "focus-ring": { "light": "#2F4BD8", "dark": "#8FA1FF" },
      "track": { "light": "#E4E1D8", "dark": "#2C3138" },
      "star": { "light": "#8A6400", "dark": "#E0B341" },
      "caution": { "light": "#8A6400", "dark": "#E0B341" },
      "danger": { "light": "#C5300A", "dark": "#FF7B52" },
      "danger-hover": { "light": "#B12E0D", "dark": "#FC8865" },
      "danger-pressed": { "light": "#A32C0F", "dark": "#FB9171" },
