  "score": {
    "$comment": "Score geometry (group 'score', 04 section 7.3). Read from tokens.ts only; not CSS variables. Lengths are px unless noted; notehead widths are relative.",
    "lane-height": 20,
    "system-gap": 12,
    "lane-glyph-size": { "live": 9, "review": 12, "highContrast": 14 },
