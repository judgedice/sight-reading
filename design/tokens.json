  "ui": {
    "$comment": "UI rules (group 'ui', 04 section 7.3). Read from tokens.ts only. Times in ms unless noted.",
    "levelThinThreshold": 10,
    "meterChipMinExcerpts": 5,
    "noSignalHintMs": 3000,
    "swapDelayMs": 400,
    "swapLatestFraction": 0.5,
